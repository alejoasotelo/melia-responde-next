# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
POSTGRES_URL=postgresql://***
# MercadoPago access token (https://www.mercadopago.com.ar/developers/panel/app).
# Webhook URL to register for "Planes y suscripciones": $BASE_URL/api/mercadopago/webhook
MP_ACCESS_TOKEN=APP_USR-***
# Optional: webhook secret to verify notification signatures
# MP_WEBHOOK_SECRET=***
# Optional: plan prices (monthly) and currency
# PLAN_VENDEDOR_PRICE=15000
# PLAN_AGENCIA_PRICE=35000
# PLAN_CURRENCY=ARS
# OpenAI key used to draft answers to questions
OPENAI_API_KEY=sk-***
# Optional: model (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
BASE_URL=http://localhost:3000
AUTH_SECRET=***
# MercadoLibre app credentials (https://developers.mercadolibre.com.ar/devcenter).
# Redirect URI to register in the app: $BASE_URL/api/meli/callback
MELI_CLIENT_ID=***
MELI_CLIENT_SECRET=***
# Optional: auth domain for your country (default auth.mercadolibre.com.ar)
# MELI_AUTH_DOMAIN=auth.mercadolibre.com.mx
# Optional: key used to encrypt stored tokens (defaults to AUTH_SECRET)
# MELI_TOKEN_ENCRYPTION_KEY=***
